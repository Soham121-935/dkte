# ============================================================
# MYCO AI backend configuration (copy to backend/.env)
# NEVER commit the real .env file. Placeholders only in this example.
# ============================================================

# --- Application -------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_READ=true                    # false = every endpoint requires login
OPEN_ACCESS=true                    # true = no sign-in; anonymous requests act as a local operator (prototype only – set false before exposing the app)

# --- Database ----------------------------------------------
# SQLite for the local prototype (default), PostgreSQL for deployment:
# DATABASE_URL=postgresql+psycopg://myco:password@localhost:5432/myco
DATABASE_URL=sqlite:///./data/myco.sqlite3
DB_AUTO_MIGRATE=true
UPLOAD_DIR=./data/uploads
# Built webpage served by this process at http://<host>:8000/ (folder with index.html + assets/, made by
# `npm run build:webpage` in frontend/). Default: ../webpage. Leave empty to run the API only.
FRONTEND_DIR=../webpage

# --- Authentication ----------------------------------------
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now        # bootstrap admin password (change after first login)

# --- AI provider (server-side only; never expose to the browser) ---
# NVIDIA API Catalog keys start with "nvapi-" and use the OpenAI-compatible endpoint below.
AI_API_KEY=
AI_PROVIDER=openai_compatible       # openai_compatible | disabled
AI_BASE_URL=https://integrate.api.nvidia.com/v1
# Model id must exist in the provider's catalog – verify with Settings -> AI diagnostics.
AI_MODEL=meta/llama-3.3-70b-instruct
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=900
AI_TEMPERATURE=0.2
AI_RATE_LIMIT_PER_MINUTE=20
AI_ENABLE_JSON_MODE=false           # enable only after diagnostics confirm response_format support

# --- MQTT (physical ESP32) ---------------------------------
MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=myco-backend
MQTT_TOPIC_PREFIX=myco
MQTT_REQUIRE_DEVICE_TOKEN=true

# --- Hardware chamber (ESP32 over HTTP) --------------------
HARDWARE_DEVICE_ID=myco-esp32-01
# Optional fixed token: hashed into the device registry at start-up so the firmware can use the same value
# (config.h -> DEVICE_TOKEN). Leave empty to generate/rotate tokens from the Connections dialog instead.
HARDWARE_DEVICE_TOKEN=

# --- ESP32-CAM phase recognition ---------------------------
CAMERA_DEVICE_ID=myco-cam-01
CAMERA_DEVICE_TOKEN=                # same idea as HARDWARE_DEVICE_TOKEN, for firmware/esp32cam/myco_cam/config.h
CAMERA_TARGET_DEVICE_ID=            # chamber the recognised phase is applied to (empty = HARDWARE_DEVICE_ID)
CAMERA_AUTO_INTERVAL_SECONDS=1800   # automatic photo interval told to the camera
CAMERA_MIN_INLIERS=20               # feature-match threshold; lower = more permissive, higher = stricter
CAMERA_AUTO_APPLY=true              # apply high/medium confidence matches to the batch stage automatically
CAMERA_AUTO_MODE=true               # switch the chamber to automatic control when a phase is applied

# --- Simulator / demo data ---------------------------------
# Demo build: both OFF so the dashboard only shows what the ESP32 sends.
# Set SIMULATOR_ENABLED=true (and optionally DEMO_SEED=true for a week of fake history) to explore without hardware;
# simulated readings are always labelled SIMULATED / DEMO in the UI.
SIMULATOR_ENABLED=false
SIMULATOR_DEVICE_ID=myco-sim-01
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_BACKFILL_HOURS=168
SIMULATOR_BACKFILL_STEP_SECONDS=60
DEMO_SEED=false

# --- Background tasks --------------------------------------
BACKGROUND_TASKS_ENABLED=true
CONTROL_LOOP_INTERVAL_SECONDS=5
PREDICTION_INTERVAL_SECONDS=300
DEVICE_OFFLINE_AFTER_SECONDS=90

# --- Notifications (optional, backend only) ----------------
NOTIFY_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

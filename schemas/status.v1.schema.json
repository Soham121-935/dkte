{
  "$id": "https://myco-ai.local/schemas/devicestatusv1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Retained presence message; publish 'offline' as the MQTT last-will. MQTT topic: myco/{device_id}/status (device -> backend). schema_version = 1.",
  "properties": {
    "device_id": {
      "title": "Device Id",
      "type": "string"
    },
    "firmware_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Firmware Version"
    },
    "ip": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ip"
    },
    "local_safety": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Local Safety"
    },
    "rssi_dbm": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rssi Dbm"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "online",
        "offline"
      ],
      "title": "Status",
      "type": "string"
    },
    "timestamp": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timestamp"
    }
  },
  "required": [
    "device_id",
    "status"
  ],
  "title": "DeviceStatusV1",
  "type": "object",
  "x-direction": "device -> backend",
  "x-mqtt-topic": "myco/{device_id}/status"
}
